# 静的ファイル (画面側) のヘッダー。API 側は Hono の secureHeaders で付けている
/*
  Content-Security-Policy: default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# 更新がすぐ反映されるよう、Service Worker と manifest は毎回確認させる
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# ビルド済みファイルは名前にハッシュが付くので長期キャッシュ
/assets/*
  Cache-Control: public, max-age=31536000, immutable
