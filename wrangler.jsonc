{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manage-shift",
  // Cloudflare のアカウント ID (秘密情報ではない)。デプロイ先を固定する
  "account_id": "e65f2066fdcba45ee2c06d3464860f4f",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manage-shift-db",
      // 本番の D1 (APAC)。ID は秘密情報ではない
      "database_id": "53540127-9a21-40a9-8ac7-d8537acbcb15",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "manage-shift-images"
    }
  ],
  // 公開先は独自ドメインだけにする。workers.dev やプレビュー URL では公開しない
  // (パスキーはドメインに結び付くため、別のドメインで登録されないように)
  "routes": [{ "pattern": "manageshift.fun", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // パスキーの RP ID / オリジン。ローカル開発では .dev.vars で空にし、アクセスされたホストから自動で決める
  "vars": { "RP_ID": "manageshift.fun", "RP_ORIGIN": "https://manageshift.fun" },
  // ANTHROPIC_API_KEY は secret (本番: `wrangler secret put ANTHROPIC_API_KEY`、開発: .dev.vars)
  "observability": { "enabled": true }
}
